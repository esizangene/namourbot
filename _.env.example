# توکن ربات از @BotFather
BOT_TOKEN=123456:ABC...
# آیدی عددی ادمین‌ها (از @userinfobot)، با کاما جدا کن
ADMIN_IDS=111111111
# تعداد دعوت لازم برای ورود
REQUIRED_INVITES=2

# دستیار هوش مصنوعی: هر API سازگار با OpenAI (مثلاً OpenRouter، Groq، Gemini و ...)
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_DAILY_LIMIT=25
